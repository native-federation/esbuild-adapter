{
  "name": "@softarc/native-federation-esbuild",
  "version": "4.0.0",
  "type": "module",
  "license": "MIT",
  "homepage": "https://native-federation.com/docs/v4/adapters/esbuild/",
  "repository": {
    "type": "git",
    "url": "https://github.com/native-federation/esbuild-adapter"
  },
  "bugs": "https://github.com/native-federation/esbuild-adapter/issues",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node esbuild.config.mjs && tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "knip": "knip",
    "test": "vitest"
  },
  "dependencies": {
    "@chialab/esbuild-plugin-commonjs": "^0.19.1",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@softarc/native-federation": "~4.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@softarc/native-federation": "~4.7.0",
    "@types/node": "~24.10.15",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "tinyglobby": "^0.2.17",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "import": "./dist/domain.js",
      "default": "./dist/domain.js"
    },
    "./frameworks/react": {
      "types": "./dist/lib/frameworks/react.d.ts",
      "import": "./dist/lib/frameworks/react.js",
      "default": "./dist/lib/frameworks/react.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
