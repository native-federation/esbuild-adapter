  "dependencies": {
    "esbuild": "^0.19.2",
    "@softarc/native-federation": "4.0.0-RC1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "acorn": "^8.15.0",
    "rollup": "^4.56.0",
    "rollup-plugin-node-externals": "^8.1.2"
  },
  "homepage": "https://github.com/native-federation/esbuild-adapter",
