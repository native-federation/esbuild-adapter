{
  "name": "@softarc/native-federation-esbuild",
  "version": "4.0.0-RC10",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@chialab/esbuild-plugin-commonjs": "^0.19.1",
    "acorn": "^8.16.0",
    "@softarc/native-federation": "~4.0.0"
  },
  "homepage": "https://github.com/native-federation/esbuild-adapter",
  "repository": {
    "type": "git",
    "url": "https://github.com/native-federation/esbuild-adapter"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./config": {
      "types": "./src/config.d.ts",
      "import": "./src/config.js",
      "default": "./src/config.js"
    },
    "./domain": {
      "types": "./src/domain.d.ts",
      "import": "./src/domain.js",
      "default": "./src/domain.js"
    },
    "./frameworks/react": {
      "types": "./src/lib/frameworks/react.d.ts",
      "import": "./src/lib/frameworks/react.js",
      "default": "./src/lib/frameworks/react.js"
    }
  },
  "files": [
    "src",
    "!**/*.tsbuildinfo"
  ]
}
